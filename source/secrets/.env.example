# PostgreSQL
POSTGRES_USER=weddingday
POSTGRES_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=weddingday
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# RabbitMQ
