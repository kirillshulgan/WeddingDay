# PostgreSQL
POSTGRES_USER=weddingday
POSTGRES_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=weddingday
MINIO_ROOT_PASSWORD=change_me_min_8_chars

# RabbitMQ
RABBITMQ_DEFAULT_USER=weddingday
RABBITMQ_DEFAULT_PASS=change_me

# Redis
REDIS_PASSWORD=change_me

# Keycloak (admin console: http://localhost:8080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# OIDC (Gateway)
OIDC_AUTHORITY=http://localhost:8080/realms/weddingday
OIDC_CLIENT_ID=weddingday-gateway
OIDC_CLIENT_SECRET=change_me